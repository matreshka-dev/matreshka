{
  "name": "@matreshka/client-bff-protocol",
  "version": "0.1.0",
  "description": "Wire protocol between Matreshka client and BFF: messages, serializable types, and enums",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.types.json && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && printf '{\"type\":\"module\"}\\n' > dist/esm/package.json && cp package.json dist/package.json",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "keywords": [
    "matreshka",
    "protocol",
    "messages",
    "websocket",
    "typescript"
  ],
  "author": "Dmitriy Tretyakov <dmitriy.tretyakov.work@gmail.com>",
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matreshka-dev/matreshka.git",
    "directory": "protocols/client-bff-protocol"
  },
  "bugs": {
    "url": "https://github.com/matreshka-dev/matreshka/issues"
  },
  "homepage": "https://github.com/matreshka-dev/matreshka/tree/main/protocols/client-bff-protocol",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@simplewebauthn/types": "^12.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^20.3.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./protocol-version": {
      "types": "./dist/protocol-version.d.ts",
      "import": "./dist/esm/protocol-version.js",
      "require": "./dist/cjs/protocol-version.js",
      "default": "./dist/cjs/protocol-version.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js",
      "default": "./dist/cjs/*.js"
    }
  }
}

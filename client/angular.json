{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "matreshka": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush",
          "viewEncapsulation": "None",
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/matreshka",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/assets"],
            "styles": ["src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "ssr": {
              "server": "src/main.server.ts",
              "ssr": {
                "entry": "src/server.ts"
              }
            },
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "24kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "android": {
              "fileReplacements": [
                {
                  "replace": "src/app/platform-provider.ts",
                  "with": "src/app/android.platform-provider.ts"
                },
                {
                  "replace": "../shared/messages/bff-to-client/register-messages.ts",
                  "with": "../shared/messages/bff-to-client/register-messages.mobile.ts"
                }
              ]
            },
            "ios": {
              "fileReplacements": [
                {
                  "replace": "src/app/platform-provider.ts",
                  "with": "src/app/ios.platform-provider.ts"
                },
                {
                  "replace": "../shared/messages/bff-to-client/register-messages.ts",
                  "with": "../shared/messages/bff-to-client/register-messages.mobile.ts"
                }
              ]
            },
            "telegram": {
              "fileReplacements": [
                {
                  "replace": "src/app/platform-provider.ts",
                  "with": "src/app/telegram.platform-provider.ts"
                },
                {
                  "replace": "../shared/messages/bff-to-client/register-messages.ts",
                  "with": "../shared/messages/bff-to-client/register-messages.telegram.ts"
                }
              ]
            },
            "max": {
              "fileReplacements": [
                {
                  "replace": "src/app/platform-provider.ts",
                  "with": "src/app/max.platform-provider.ts"
                },
                {
                  "replace": "../shared/messages/bff-to-client/register-messages.ts",
                  "with": "../shared/messages/bff-to-client/register-messages.max.ts"
                }
              ]
            },
            "browser": {
              "fileReplacements": [
                {
                  "replace": "src/app/platform-provider.ts",
                  "with": "src/app/browser.platform-provider.ts"
                },
                {
                  "replace": "../shared/messages/bff-to-client/register-messages.ts",
                  "with": "../shared/messages/bff-to-client/register-messages.browser.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json",
              "assets": [
                "src/favicon.svg",
                "src/favicon.png",
                "src/pwa.svg",
                "src/pwa.png",
                "src/.well-known",
                "src/assets"
              ]
            }
          },
          "defaultConfiguration": "production,browser"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "android": {
              "buildTarget": "matreshka:build:android,development"
            },
            "ios": {
              "buildTarget": "matreshka:build:ios,development"
            },
            "telegram": {
              "buildTarget": "matreshka:build:telegram,development"
            },
            "max": {
              "buildTarget": "matreshka:build:max,development"
            },
            "browser": {
              "buildTarget": "matreshka:build:browser,development"
            }
          },
          "options": {
            "host": "0.0.0.0",
            "ssl": false,
            "sslCert": "./cert.pem",
            "sslKey": "./key.pem"
          },
          "defaultConfiguration": "browser"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "matreshka:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
